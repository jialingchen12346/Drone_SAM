\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Visualization of adaptive fusion weights in CACAF. Thermal contributions are more evident at shallow and intermediate scales, especially in challenging conditions, while deeper scales are largely dominated by the RGB branch. This suggests that condition-aware multimodal adaptation mainly occurs before high-level semantic representations become strongly RGB-centered.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:weights}{{4}{8}{Visualization of adaptive fusion weights in CACAF. Thermal contributions are more evident at shallow and intermediate scales, especially in challenging conditions, while deeper scales are largely dominated by the RGB branch. This suggests that condition-aware multimodal adaptation mainly occurs before high-level semantic representations become strongly RGB-centered}{figure.4}{}}
